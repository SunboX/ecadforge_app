{
    "name": "ecadforge_app",
    "version": "1.9.26",
    "description": "Browser-based viewer for Altium, KiCad, Gerber, and CircuitJSON design files",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "start": "node src/server.mjs",
        "build:static": "node scripts/build-static-deploy.mjs",
        "test": "node --test",
        "check:circuitjson-schema": "node scripts/check-circuitjson-schema-drift.mjs",
        "sync:structured-data": "node scripts/sync-structured-data.mjs",
        "check:structured-data": "node scripts/check-structured-data.mjs",
        "format": "prettier --write .",
        "check:format": "prettier --check ."
    },
    "dependencies": {
        "@sunbox/occt-import-js": "^0.0.25",
        "altium-toolkit": "^1.1.41",
        "circuitjson-toolkit": "^1.0.17",
        "earcut": "^3.0.2",
        "express": "^5.1.0",
        "fflate": "^0.8.2",
        "gerber-toolkit": "^0.1.21",
        "kicad-toolkit": "^1.0.29",
        "pcb-scene3d-viewer": "^1.1.49",
        "polygon-clipping": "^0.15.7",
        "three": "^0.183.2"
    },
    "devDependencies": {
        "prettier": "^3.4.2"
    },
    "engines": {
        "node": ">=20"
    }
}
